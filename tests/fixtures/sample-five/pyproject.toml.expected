[project]
name = "sample-five"
version = "0.1.0"
requires-python = ">=3.13"
dependencies = [
    "requests>=2.32.3",
]

[project.optional-dependencies]
http = [
    "pytest-cov>=6.1.1",
    "requests>=2.32.3",
]

[dependency-groups]
dev = [
    "pytest>=8.3.5",
    "requests>=2.32.3",
]
test = [
    "pytest>=8.3.5",
    "pytest-cov>=6.1.1",
]
